# Stellar Stream Hive — environment configuration
#
# Copy this file to `.env.local` and fill in the values below.

# --- Contract IDs ---------------------------------------------------------
# Stellar Stream Hive contracts deployed to TESTNET on 2026-10-12. The source of
# truth is DEPLOYMENTS.md / deployments/testnet.json in:
#   https://github.com/Stellar-Hive/stellar-stream-hive-contract
#
# Redeploying (scripts/deploy.sh) creates NEW contract ids, so update these
# three values from that script's output. They are only valid on testnet; leave
# them blank (or point at a mainnet deployment) for any other network, and
# contract-calling features will show a clear "not yet configured" state.

NEXT_PUBLIC_STREAM_CONTRACT_ID=CCYM2PIMNHOJKWRV677QQNFUMNU2JKEHXTQKK6D3D7JF2UTEB5JNINYY
NEXT_PUBLIC_VAULT_CONTRACT_ID=CB67RYDOOIOR2YZERK77URMXDCOLDAVOFELZERDCH562OH2NMP2UNG2N
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=CA3MEGSTTI576GDVRFXZ2YJGGO3LAKOPNPGZ34F46FEDDHDCOWYQTNMG

# --- Network ---------------------------------------------------------------
# Stellar network passphrase and RPC/Horizon endpoints. Defaults target testnet.

NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# --- Stellar Stream Hive API -------------------------------------------------
# Registry/indexer API used for platform-wide stats on the landing page and
# for listing streams by sender/recipient. See:
#   https://github.com/Stellar-Hive/stellar-stream-hive-api
# If unset, the app falls back to a graceful empty/loading state rather than
# fabricating numbers.

NEXT_PUBLIC_API_BASE_URL=

# --- Site -------------------------------------------------------------------
# Public base URL this app is deployed at. Used for Open Graph/metadata URLs
# (app/layout.tsx) and the sitemap (app/sitemap.ts). Defaults to
# http://localhost:3000 for local development; set this to your real
# deployment URL (e.g. https://app.stellarstreamhive.com) in production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
